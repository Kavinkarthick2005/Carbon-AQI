# Carbon AQI System — Backend Configuration Template
# Copy this file to .env and provide your deployment-specific configuration.
# Never commit real credentials or .env to version control.

# Application Environment: 'development' or 'production' (default: development)
APP_ENV=development

# Database Connection: PostgreSQL connection string (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Database Connection Pool Settings (Conservative defaults for multi-worker deployments)
# Max total connections per instance = application_workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# E.g., 4 workers * (5 + 10) = 60 connections max (PostgreSQL default max_connections = 100)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins: Comma-separated list of origins (Required in production, must use HTTPS without paths)
# Development default: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK Credentials: Path to service account JSON (Optional, fail-closed auth if missing)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# OpenWeather API Key: Live ambient air quality ingestion (Optional)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Groq API Key: Llama-3 LLM assistant for chatbot (Optional, falls back to rule-based engine if absent)
GROQ_API_KEY=your_groq_api_key_here
